{
  "name": "let-her-cook",
  "private": true,
  "version": "1.0.0",
  "description": "Let ’Em Cook — a local-first personal recipe library. Every recipe has a home.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr-assets.mjs && vite",
    "build": "node scripts/copy-ocr-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.1.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.0.10",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
